{
	"name": "smartify-os-cli",
	"version": "0.1.1",
	"description": "The SmartifyOS command line tool, sets up, builds and deploys your car infotainment system",
	"private": true,
	"type": "module",
	"homepage": "https://smartify-os.com/",
	"bin": {
		"smartify-os": "./src/index.ts"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test",
		"check": "bun run scripts/check.ts",
		"check:all": "bun run scripts/check.ts --all",
		"build": "bun run scripts/build.ts",
		"build:all": "bun run scripts/build.ts --all",
		"install:dev": "bun run scripts/install-local.ts --dev",
		"install:local": "bun run scripts/install-local.ts",
		"release": "bun run scripts/release.ts"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
